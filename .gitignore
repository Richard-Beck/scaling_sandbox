/literature_models/debelly_2026_mechanochemical/src/debelly/one_d/protocols/VTU/

# M2072 bulk campaigns were retired; the compact retirement record is eligible.
/literature_models/M2072/archive/

# Rebuildable reports and delivery assets. Report sources remain visible.
