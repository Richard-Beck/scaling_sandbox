# Local tools, language caches, and build products.
.codex/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.coverage
.Rhistory
.RData
.Ruserdata
Rplots.pdf
node_modules/
build/
dist/

# Scheduler output and interrupted downloads.
*.out
*.err
logs/
*.aria2

# Raw inputs and downloaded biosensor payloads; keep acquisition scripts visible.
/data/
/ht1080biosensors/*
!/ht1080biosensors/*.slurm
!/ht1080biosensors/*.py
!/ht1080biosensors/*.sh
!/ht1080biosensors/*.md

# Historical backup location, if recreated; no backup currently exists here.
/reorg/legacy/

# Generated campaigns. Curated polarity evidence is explicitly eligible below.
/migration1d/results/**
!/migration1d/results/README.md
/polarity1d/results/*
!/polarity1d/results/README.md
!/polarity1d/results/data/
!/polarity1d/results/figures/
/literature_models/*/results/**
!/literature_models/*/results/README.md
